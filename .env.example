# --- Base de datos -----------------------------------------------------------
# Cadena de conexión de Postgres usada por Prisma.
DATABASE_URL="postgresql://andesintel:andesintel@localhost:5432/andesintel?schema=public"

# --- Autenticación (Auth.js / NextAuth) --------------------------------------
# Secreto para firmar los JWT de sesión. Generar con: openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth (opcional: el botón "Continuar con Google" solo aparece si
# ambas variables están definidas). Crear credenciales en
# https://console.cloud.google.com/apis/credentials con el redirect URI
# <origen>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
