# --- Base de datos -----------------------------------------------------------
# Cadena de conexión de Postgres usada por Prisma (app, migraciones y seed).
#
# Neon (produccion): usar la connection string del proyecto, con SSL.
#   DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
#   Nota: para `prisma migrate` usar la URL DIRECTA (sin "-pooler");
#   la URL con pooler (PgBouncer) es para la app en runtime.
#
# Postgres local (desarrollo):
DATABASE_URL="postgresql://gestion_mercado:gestion_mercado@localhost:5432/gestion_mercado?schema=public"

# --- Autenticación (Auth.js / NextAuth) --------------------------------------
# Secreto para firmar los JWT de sesión. Generar con: openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth (opcional: el botón "Continuar con Google" solo aparece si
# ambas variables están definidas). Crear credenciales en
# https://console.cloud.google.com/apis/credentials con el redirect URI
# <origen>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Pagos --------------------------------------------------------------------
# Pasarela activa. Hoy solo "stripe"; Transbank/Flow se suman implementando
# la interfaz PaymentProvider (src/lib/payments/provider.ts).
PAYMENT_PROVIDER="stripe"

# Claves de Stripe (modo test: https://dashboard.stripe.com/test/apikeys).
# Sin estas variables la app funciona, pero el checkout responde 503.
STRIPE_SECRET_KEY=""
# Secreto de firma del webhook (endpoint /api/webhooks/stripe). En local:
# stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=""
# Prices mensuales creados en Stripe para cada plan pagado.
STRIPE_PRICE_PROFESIONAL=""
STRIPE_PRICE_CORPORATIVO=""

# --- Administración -----------------------------------------------------------
# Si ambas están definidas, `npm run db:seed` crea (o promueve) la cuenta
# ADMIN con estas credenciales. El panel vive en /admin.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
