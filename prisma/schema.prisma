// Esquema de datos de Gestión de Mercado.
//
// Convención bilingüe: los campos de texto que existen en español e inglés
// se guardan como Json con la forma { "es": string, "en": string }
// (ver `LocalizedText` en src/types y su schema Zod en src/lib/validation.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Usuarios y suscripciones
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

/// Nivel de acceso efectivo de un usuario. Se materializa en `User.tier`
/// y lo mantienen sincronizado los webhooks de pago.
enum Tier {
  FREE
  PROFESIONAL
  CORPORATIVO
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  /// Empresa declarada al registrarse (opcional).
  company      String?
  /// Hash bcrypt; null para cuentas creadas solo con OAuth.
  passwordHash String?
  image        String?
  role         Role      @default(USER)
  tier         Tier      @default(FREE)
  emailVerified DateTime?

  subscription Subscription?
  accounts     Account[]
  sessions     Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Modelos estándar del adapter de Auth.js (OAuth) ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tier   Tier
  status SubscriptionStatus

  /// Pasarela que originó la suscripción ("stripe" hoy; "transbank"/"flow" a futuro).
  provider               String  @default("stripe")
  providerCustomerId     String?
  providerSubscriptionId String? @unique
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerCustomerId])
}

// ---------------------------------------------------------------------------
// Contenido
// ---------------------------------------------------------------------------

enum Sector {
  mineria
  energia
  litio
  hidrogeno
  desalinizacion
}

enum ProjectStatus {
  operation
  construction
  approved
  evaluation
}

model Company {
  id      String   @id @default(cuid())
  slug    String   @unique
  name    String   @unique
  sectors Sector[]

  /// { es, en }
  industry    Json
  /// { es, en }
  description Json
  /// Lista de { es, en }
  services    Json

  website   String
  email     String
  phone     String
  city      String
  employees String
  founded   Int

  executives Executive[]
  projects   Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
}

model Executive {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name  String
  /// { es, en }
  role  Json
  email String
  /// Posición dentro del perfil de la empresa.
  order Int    @default(0)

  @@index([companyId])
}

model Project {
  id     String        @id @default(cuid())
  name   String
  sector Sector
  status ProjectStatus
  region String

  /// Nombre del titular tal como se publica (se conserva aunque la empresa
  /// no esté en el directorio); `companyId` enlaza cuando sí lo está.
  companyName String
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  lat            Float
  lng            Float
  /// Inversión estimada en millones de USD.
  investmentUsdM Float
  /// Año estimado de puesta en marcha.
  startYear      Int
  /// { es, en }
  description    Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sector, status])
  @@index([region])
  @@index([companyId])
}

model Article {
  id      String  @id @default(cuid())
  /// { es, en }
  title   Json
  /// { es, en } — bajada pública del artículo.
  excerpt Json
  /// { es, en } — cuerpo completo; solo para miembros cuando `premium` es true.
  /// Para artículos externos SIEMPRE es null: somos agregador, nunca
  /// copiamos el cuerpo (el link lleva al sitio original).
  body    Json?
  sector  Sector
  /// Nombre visible de la fuente (medio propio o externo).
  sourceName String
  /// Sitio de la fuente externa (home del medio).
  sourceUrl  String?
  /// URL del artículo original; única, es la clave de deduplicación.
  originalUrl String? @unique
  publishedAt DateTime
  imageUrl    String?
  /// true = ingresado por RSS; el click abre el artículo original.
  isExternal  Boolean @default(false)
  /// Resumen corto del feed, recortado (máx. 250 caracteres).
  summary     String? @db.VarChar(250)
  readingMinutes Int
  featured Boolean @default(false)
  premium  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publishedAt(sort: Desc)])
  @@index([sector])
  @@index([isExternal])
}

model Study {
  id      String  @id @default(cuid())
  /// { es, en }
  title   Json
  /// { es, en } — resumen; para estudios premium es contenido de miembros.
  summary Json
  sector  Sector
  pages   Int
  date    DateTime
  premium Boolean @default(false)

  /// PDF descargable (subido desde el panel admin).
  fileUrl       String?
  coverImageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date(sort: Desc)])
  @@index([sector])
}

model NewsletterSubscriber {
  id     String @id @default(cuid())
  email  String @unique
  locale String @default("es")

  createdAt DateTime @default(now())
}

/// Lead comercial del formulario de contacto de la portada.
model ContactLead {
  id         String  @id @default(cuid())
  name       String
  company    String
  email      String
  personRut  String?
  companyRut String?
  phone      String?
  /// Claves de temas de interés (ver CONTACT_TOPICS en src/lib/constants.ts).
  topics     String[]
  locale     String  @default("es")

  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}
